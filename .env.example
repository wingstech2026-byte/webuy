# =============================================================================
# WiBuy - Buy and sell easy for Salone.
# Copy to .env, then run: php artisan key:generate
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME=WiBuy
# local | production
APP_ENV=local
# Generated by `php artisan key:generate`
APP_KEY=
# MUST be false in production
APP_DEBUG=true
# Public URL, used for share links and Open Graph tags. Use https:// in production.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Comma separated proxy IPs, or * when behind Nginx/a load balancer on the same host.
# Needed so Laravel sees the real client IP (OTP rate limiting) and https.
TRUSTED_PROXIES=

# ---- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database ----------------------------------------------------------------
# sqlite for local development, pgsql for production.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=wibuy
# DB_USERNAME=wibuy
# DB_PASSWORD=

# ---- Session / cache / queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
# SMS, image processing, payment calls and chat broadcasts run on the queue.
# Run `php artisan queue:work` (see README). `sync` runs them inside the web request (quick demos only).
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@wibuy.sl"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---- WiBuy -------------------------------------------------------------------
WIBUY_TAGLINE="Buy and sell easy for Salone."
# WhatsApp number for the support link in the footer (digits only, with 232)
SUPPORT_WHATSAPP=23276000000
# Seeded administrator (log in with this number + SMS code)
ADMIN_PHONE=076000000
ADMIN_NAME="WiBuy Admin"

# ---- Marketplace rules -------------------------------------------------------
# WiBuy's commission, as a percent of each order's item subtotal. Admins can change it in
# the admin panel (Settings); this is the starting value.
COMMISSION_PERCENT=5
# Smallest payout a seller can request, in SLE (changeable in Settings too)
MIN_PAYOUT=100.00
# Minutes an unpaid checkout holds its stock before it is cancelled
PAYMENT_HOLD_MINUTES=15
# Hours a seller has to accept a paid order before the buyer is refunded automatically
ACCEPT_WITHIN_HOURS=24
# Days after shipped/delivered until an order completes by itself (if the buyer does nothing and no dispute is open)
AUTO_COMPLETE_DAYS=3

# ---- Login codes (SMS OTP) ---------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ---- SMS ---------------------------------------------------------------------
# log  = write messages to storage/logs/laravel.log (development)
# http = POST to a bulk-SMS provider (see config/sms.php for the JSON payload)
SMS_DRIVER=log
# Alphanumeric sender ID shown on the phone (must be registered with your provider)
SMS_SENDER_ID=WIBUY
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# ---- Payments ----------------------------------------------------------------
# fake    = development only. Payment page shows "Simulate approve/decline" buttons.
#           Refused when APP_ENV=production.
# pawapay = real mobile money (Orange Money, Afrimoney) through pawaPay: deposits, refunds, payouts.
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=SLE
# Sandbox by default. Production: https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
# pawaPay operator ("correspondent") codes for Sierra Leone
PAWAPAY_OPERATOR_ORANGE=ORANGE_SLE
PAWAPAY_OPERATOR_AFRIMONEY=AFRIMONEY_SLE

# ---- Chat (Laravel Reverb WebSockets) ---------------------------------------
# Real-time chat uses Reverb. If it is not running, chat still works: the browser
# falls back to polling every 5 seconds. Start it with: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the browser connects (public host/port/scheme)
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server listens
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Chat options
# Turns on one-to-one direct chat (buyer <-> seller, "Ask the seller") and voice notes.
# While false, "Ask the seller" shows a "coming soon" page with the seller's phone/WhatsApp instead.
CHAT_DIRECT_ENABLED=false
CHAT_PAGE_SIZE=30
CHAT_MAX_PER_MINUTE=20
CHAT_MAX_LENGTH=1000
# At most one "new messages" SMS per person per conversation in this many minutes
CHAT_SMS_COOLDOWN_MINUTES=60
CHAT_POLL_SECONDS=5

# ---- Development ---------------------------------------------------------------
# To open the app from a phone on the same Wi-Fi while `npm run dev` runs, put this computer's
# Wi-Fi address here (and in APP_URL). Leave empty to use localhost only.
VITE_DEV_HOST=

# Part B optional features
ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
WIBUY_GLOBAL_ENABLED=false

# Phone push notifications (Firebase). See README > Notifications.
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# Maps: tile server shown in the browser, optional self-hosted OSRM for road distances
MAP_TILE_URL=
ROUTING_URL=
